{% extends 'base.html.twig' %}
{% block title %}Modifier : {{ categorie.Designation }}{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fa fa-edit"></i> Modifier : {{ categorie.Designation }}</h1>
<div class="card shadow-sm"><div class="card-body p-4">{{ include('categorie/_form.html.twig') }}</div></div>
<hr>
<form method="post" action="{{ path('app_categorie_delete', {'id': categorie.id}) }}"
      onsubmit="return confirm('Supprimer cette catégorie ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
    <button class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Supprimer</button>
</form>
{% endblock %}
