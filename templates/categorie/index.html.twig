{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fa fa-tags"></i> Catégories</h1>
    <a href="{{ path('app_categorie_new') }}" class="btn btn-success">
        <i class="fa fa-plus"></i> Nouvelle catégorie
    </a>
</div>
<table class="table table-striped shadow-sm">
    <thead class="table-dark">
        <tr><th>Id</th><th>Désignation</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for categorie in categories %}
        <tr>
            <td>{{ categorie.id }}</td>
            <td>{{ categorie.Designation }}</td>
            <td>
                <a href="{{ path('app_categorie_show', {'id': categorie.id}) }}" class="btn btn-sm btn-info"><i class="fa fa-eye"></i></a>
                <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-sm btn-warning"><i class="fa fa-edit"></i></a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3" class="text-center text-muted">Aucune catégorie.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
