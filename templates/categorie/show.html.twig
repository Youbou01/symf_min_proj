{% extends 'base.html.twig' %}
{% block title %}{{ categorie.Designation }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between mb-4">
    <h1><i class="fa fa-tag"></i> {{ categorie.Designation }}</h1>
    <div>
        <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-warning"><i class="fa fa-edit"></i> Modifier</a>
        <a href="{{ path('app_categorie_index') }}" class="btn btn-secondary ms-2"><i class="fa fa-arrow-left"></i> Retour</a>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table">
            <tr><th>Id</th><td>{{ categorie.id }}</td></tr>
            <tr><th>Désignation</th><td>{{ categorie.Designation }}</td></tr>
        </table>
    </div>
</div>
{% endblock %}
