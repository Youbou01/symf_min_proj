<form method="post" action="{{ path('app_peinture_delete', {'id': peinture.id}) }}"
      onsubmit="return confirm('Confirmer la suppression ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ peinture.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="fa fa-trash"></i> Supprimer
    </button>
</form>
