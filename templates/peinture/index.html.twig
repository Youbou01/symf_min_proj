{% extends 'base.html.twig' %}

{% block title %}Liste des Peintures{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fa fa-paint-brush"></i> Peintures</h1>
    <a href="{{ path('app_peinture_new') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Nouvelle peinture
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Largeur</th>
                <th>Hauteur</th>
                <th>En vente</th>
                <th>Prix (TND)</th>
                <th>Date réalisation</th>
                <th>Artiste</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for peinture in peintures %}
            <tr>
                <td>{{ peinture.id }}</td>
                <td>{{ peinture.Nom }}</td>
                <td>{{ peinture.largeur }}</td>
                <td>{{ peinture.Hauteur }}</td>
                <td>
                    {% if peinture.enVente %}
                        <span class="badge bg-success">Oui</span>
                    {% else %}
                        <span class="badge bg-secondary">Non</span>
                    {% endif %}
                </td>
                <td>{{ peinture.prix }}</td>
                <td>{{ peinture.dateRealisation ? peinture.dateRealisation|date('d/m/Y') : '' }}</td>
                <td>{{ peinture.personne }}</td>
                <td>
                    <a href="{{ path('app_peinture_show', {'id': peinture.id}) }}" class="btn btn-sm btn-info">
                        <i class="fa fa-eye"></i>
                    </a>
                    <a href="{{ path('app_peinture_edit', {'id': peinture.id}) }}" class="btn btn-sm btn-warning">
                        <i class="fa fa-edit"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="9" class="text-center text-muted">Aucune peinture trouvée.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
