{% extends 'base.html.twig' %}
{% block title %}Commentaires{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fa fa-comments"></i> Commentaires</h1>
    <a href="{{ path('app_commentaire_new') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Nouveau commentaire
    </a>
</div>
<table class="table table-striped shadow-sm">
    <thead class="table-dark">
        <tr><th>Id</th><th>Nom</th><th>Date</th><th>Personne</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for commentaire in commentaires %}
        <tr>
            <td>{{ commentaire.id }}</td>
            <td>{{ commentaire.Nom }}</td>
            <td>{{ commentaire.Date|date('d/m/Y') }}</td>
            <td>{{ commentaire.personne }}</td>
            <td>
                <a href="{{ path('app_commentaire_show', {'id': commentaire.id}) }}" class="btn btn-sm btn-info"><i class="fa fa-eye"></i></a>
                <a href="{{ path('app_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-sm btn-warning"><i class="fa fa-edit"></i></a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="text-center text-muted">Aucun commentaire.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
