{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord — Gestion Peintures{% endblock %}

{% block main %}
<div class="row g-4 mt-2">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="display-4 text-primary mb-2"><i class="fa fa-paint-brush"></i></div>
            <h5 class="card-title">Peintures</h5>
            <p class="text-muted">Gérer le catalogue de peintures</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\PeintureCrudController') }}"
               class="btn btn-primary btn-sm">Voir les peintures</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="display-4 text-success mb-2"><i class="fa fa-tags"></i></div>
            <h5 class="card-title">Catégories</h5>
            <p class="text-muted">Gérer les catégories de peintures</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\CategorieCrudController') }}"
               class="btn btn-success btn-sm">Voir les catégories</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="display-4 text-warning mb-2"><i class="fa fa-comments"></i></div>
            <h5 class="card-title">Commentaires</h5>
            <p class="text-muted">Gérer les commentaires</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\CommentaireCrudController') }}"
               class="btn btn-warning btn-sm">Voir les commentaires</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="display-4 text-info mb-2"><i class="fa fa-user"></i></div>
            <h5 class="card-title">Personnes</h5>
            <p class="text-muted">Gérer les personnes</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\PersonneCrudController') }}"
               class="btn btn-info btn-sm">Voir les personnes</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="display-4 text-dark mb-2"><i class="fa fa-users"></i></div>
            <h5 class="card-title">Utilisateurs</h5>
            <p class="text-muted">Gérer les comptes utilisateurs</p>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController') }}"
               class="btn btn-dark btn-sm">Voir les utilisateurs</a>
        </div>
    </div>

</div>
{% endblock %}
